#. Translators: dialog text shown when trying to install the add-on on unsupported systems.
#: addon\installTasks.py:27
#, python-brace-format
msgid "You are using {releaseName} ({build}), a Windows release not supported by Windows App Essentials NVDA add-on.\n"
"This add-on requires {supportedReleaseName} ({supportedBuild}) or later."
msgstr "Sie verwenden {releaseName} ({build}), das von Windows App Essentials nicht unterstützt wird.\n"
"Diese NVDA-Erweiterung benötigt {supportedReleaseName} ({supportedBuild}) oder neuer."

#. Translators: dialog title shown when trying to install the add-on on unsupported systems.
#: addon\installTasks.py:37
msgid "Windows App Essentials install error"
msgstr "Installationsfehler von Windows App Essentials"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Windows App Essentials"
msgstr "Windows App Essentials"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Improving support for various apps and controls on Windows 11"
msgstr "Verbesserte Unterstützung für verschiedene Apps und Steuerelemente in Windows 11"

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "* Initial support for Windows 11 Version 26H2 (2026 Update)."
msgstr "* Initial support for Windows 11 Version 26H2 (2026 Update)."

